# Storyblok Content Delivery API token (Settings > Access Tokens).
# A Preview token shows drafts, a Public token shows published content only.
STORYBLOK_DELIVERY_API_TOKEN=<REPLACE_WITH_YOUR_TOKEN>
STORYBLOK_API_BASE_URL=https://api.storyblok.com
# eu, us, ca, ap or cn
STORYBLOK_REGION=eu

# Optional. "draft" or "published". Defaults to draft in development and published in production.
STORYBLOK_VERSION=

# Optional. Timezone used to display race times. Defaults to Europe/London.
SITE_TIMEZONE=Europe/London
